# Nova Corpus Pipeline Configuration

# GitHub API (optional, for higher rate limits)
GITHUB_TOKEN=

# Reddit API (if using Reddit source)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Nebius/S3 Configuration
NEBIUS_ENDPOINT=https://storage.us-central1.nebius.cloud:443
NEBIUS_ACCESS_KEY_ID=
NEBIUS_SECRET_ACCESS_KEY=
NEBIUS_BUCKET=cos

# Pipeline Settings
INGESTION_INTERVAL=300  # seconds
PROCESSING_WORKERS=4
USE_AIRFLOW=false

# Monitoring
DASHBOARD_PORT=5000
METRICS_PORT=9090

# Storage
DATA_DIR=/home/x/data/corpora/corpora/data
LOG_DIR=/home/x/data/corpora/corpora/logs